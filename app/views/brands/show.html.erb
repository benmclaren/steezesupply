<div class="flex justify-between items-center">
  <h1 class="lg:text-8xl md:text-6xl sm:text-4xl hero-text !mr-4"><%= @brand.name %></h1>
  <% if @brand.favourites.empty? %>
    <%= button_to [@brand, @favourite], method: :post do %>
      <i class="fa-regular fa-bookmark text-2xl cursor-pointer"></i>
    <% end %>
  <% else %>
    <% favourite = current_user.favourites.find_by(brand: @brand) %>
    <%= link_to favourite_path(favourite), data: {turbo_method: :delete} do %>
      <i class="fa-solid fa-bookmark text-2xl cursor-pointer"></i>
    <% end %>
  <% end %>
</div>
<div class="flex flex-col items-center">
  <%= cl_image_tag @brand.photo.key, class: "object-cover mb-8" %>
  <p class="max-w-lg text-center text-2xl">
    <%= @brand.bio %>  
  </p>
</div>



<div class="grid grid-cols-2 gap-8 mt-16">
  <div class="bg-gray-100 rounded-lg p-8">
    <p class="text-2xl font-bold mb-2">Contact</p>
    <p><%= link_to @brand.address, @brand.address, target: "_blank" %></p>
    <p><%= link_to @brand.email, "mailto:#{@brand.email}" %></p>
    <p class="text-2xl font-bold mt-4 mb-2">Social</p>
    <%= link_to @brand.social, target: "_blank" do %>
      <i class="fa-brands fa-instagram text-4xl"></i>
    <% end %>
  </div>

  <div class="bg-gray-100 rounded-lg p-8">
    <p class="text-2xl font-bold mb-2">Riders</p>
    <div class="flex flex-wrap gap-4">
      <% @brand.athletes.each do |athlete| %>
        <%= link_to athlete_path(athlete) do %>
          <%= cl_image_tag athlete.photo.key, class: "rounded-full object-cover size-24 mb-3" %>  
        <% end %>
      <% end %>
    </div>
  </div>
</div>
